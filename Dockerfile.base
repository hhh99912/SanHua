FROM node:22.21.1-slim

# 安装运行 Electron 33 所需的 Linux GUI / X11 / GTK3 / 音频与中文字体库
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgtk-3-0 \
    libnss3 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    libnotify4 \
    libatspi2.0-0 \
    libuuid1 \
    libsecret-1-0 \
    libappindicator3-1 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libasound2 \
    libpulse0 \
    libgbm1 \
    libdrm2 \
    ca-certificates \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
CMD ["./datav-scada-studio", "--no-sandbox", "--disable-gpu-sandbox", "--disable-dev-shm-usage"]
